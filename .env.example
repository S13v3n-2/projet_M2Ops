# Copier en `.env` (ignoré par git) puis adapter.
# Ce fichier sert à la fois aux scripts python lancés en local et à docker compose.

# Profils compose actifs : local (rustfs), dev (adminer). En prod cloud : vide ou prod.
COMPOSE_PROFILES=local,dev
SOURCES_FILE=./sources.csv
DATA_DIR=./data

# Base des données (silver et gold). En local, la base est exposée sur localhost:5432.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=la_gazette_des_sorciers
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/la_gazette_des_sorciers

# Data lake RustFS (bronze). Les clés servent aussi à créer le compte RustFS.
# Les conteneurs lancés par Kestra utilisent http://rustfs:9000 (docker-compose.yml) ;
# pour un S3 cloud, définir KESTRA_S3_ENDPOINT_URL et retirer le profil local.
# KESTRA_S3_ENDPOINT_URL=https://s3.example.com
S3_ENABLED=true
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=gazette-bronze
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key

# Kestra
# Chemin absolu (côté hôte) du dossier de données. Windows + Docker Desktop, pour
# D:/Etude/M2/M2Ops/projet_M2Ops/data :
#   /run/desktop/mnt/host/d/Etude/M2/M2Ops/projet_M2Ops/data
DATA_DIR_HOST=/chemin/absolu/vers/projet_M2Ops/data
# Compte de l'interface (email valide ; mot de passe 8+ caractères, 1 majuscule, 1 chiffre)
KESTRA_USER=admin@kestra.io
KESTRA_PASSWORD=Admin1234
KESTRA_DB_PASSWORD=kestra
# Webhook Discord d'alerte quand le contrôle qualité échoue (secret, à ne pas commiter)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-your-webhook-id/replace-with-your-webhook-token
